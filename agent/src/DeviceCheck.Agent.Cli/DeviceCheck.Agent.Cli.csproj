<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DeviceCheck.Agent.Cli</AssemblyName>
    <RootNamespace>DeviceCheck.Agent.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Reflection-based System.Text.Json and COM interop: trimming is not safe -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceCheck.Agent.Core\DeviceCheck.Agent.Core.csproj" />
    <ProjectReference Include="..\DeviceCheck.Agent.Collectors\DeviceCheck.Agent.Collectors.csproj" />
    <ProjectReference Include="..\DeviceCheck.Agent.Export\DeviceCheck.Agent.Export.csproj" />
    <ProjectReference Include="..\DeviceCheck.Agent.Windows\DeviceCheck.Agent.Windows.csproj" />
  </ItemGroup>

</Project>
